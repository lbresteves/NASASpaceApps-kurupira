{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",

    /* Path aliases (also used by Vite via resolve.tsconfigPaths) */
    "paths": {
      "@features": ["./src/features/index.ts"],
      "@features/*": ["./src/features/*"],
      "@pages": ["./src/pages/index.ts"],
      "@shared/api": ["./src/shared/api/index.ts"],
      "@shared/components": ["./src/shared/components/index.ts"],
      "@shared/hooks": ["./src/shared/hooks/index.ts"],
      "@shared/theme": ["./src/shared/theme/index.ts"],
      "@shared/types": ["./src/shared/types/index.ts"],
      "@shared/utils": ["./src/shared/utils/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
